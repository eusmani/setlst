<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>development</string>
	<!-- Shared container the app writes recently-logged albums into and the
	     Home Screen widget reads from. Both targets must declare it. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.app.setlst.native</string>
	</array>
	<!-- Links the app to setlst.dev's saved passwords. Without this the keychain
	     treats the web view as an unrelated site, so nothing offers to save on
	     sign-in and nothing is offered to fill next time. Paired with the
	     webcredentials entry in /.well-known/apple-app-site-association. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>webcredentials:setlst.dev</string>
	</array>
</dict>
</plist>
