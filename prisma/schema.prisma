generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  email     String   @unique
  password  String
  bio           String?
  avatar        String?
  phone         String?
  // SHA-256 of the normalized phone number. Contact matching compares hashes so
  // the numbers in someone's address book never reach the server in the clear
  // (App Store guideline 5.1.2 — data use limited to the disclosed purpose).
  phoneHash     String?
  emailVerified Boolean @default(false)
  isPrivate     Boolean @default(false)

  // Guideline 1.2 moderation. A suspended account can sign in (so it can appeal
  // or delete its data) but cannot post, message, or follow.
  suspendedAt     DateTime?
  suspendedReason String?
  isModerator     Boolean   @default(false)
  // Guideline 1.2 / 5.1.1: recorded acceptance of the EULA + privacy policy.
  termsAcceptedAt DateTime?
  termsVersion    String?
  favoriteGenres String?
  topAlbums     String?
  createdAt     DateTime @default(now())

  // SETLST Plus (premium) — driven by Apple IAP via RevenueCat webhooks.
  isPremium     Boolean   @default(false)
  premiumPlan   String?   // e.g. "plus_monthly", "plus_yearly"
  premiumUntil  DateTime? // current period end; premium is active while now < this
  revenueCatId  String?   // RevenueCat app_user_id linked to this account

  // Spotify account link (authorization-code flow) — powers listening-based
  // concert + album recommendations.
  spotifyAccessToken  String?
  spotifyRefreshToken String?
  spotifyTokenExpires DateTime?
  spotifyConnectedAt  DateTime?

  reviews      Review[]
  likes        Like[]
  deviceTokens DeviceToken[]
  savedAlbums  SavedAlbum[]
  crates       Crate[]
  threads       Thread[]
  threadReplies ThreadReply[]
  threadVotes    ThreadVote[]
  replyVotes     ReplyVote[]
  sharesSent     ThreadShare[] @relation("sharesSent")
  sharesReceived ThreadShare[] @relation("sharesReceived")
  dmSent         DirectMessage[]   @relation("dmSent")
  dmReceived     DirectMessage[]   @relation("dmReceived")
  messageReactions MessageReaction[]
  concerts       ConcertAttendance[]
  comments     Comment[]
  commentLikes CommentLike[]
  followers    Follow[] @relation("following")
  following    Follow[] @relation("follower")
  followRequestsSent     FollowRequest[] @relation("requester")
  followRequestsReceived FollowRequest[] @relation("target")
  artistFollows ArtistFollow[]
  resetTokens  PasswordResetToken[]
  emailTokens  EmailVerificationToken[]
  signInCodes  SignInCode[]

  blocksMade     Block[] @relation("blocksMade")
  blocksReceived Block[] @relation("blocksReceived")
  reportsFiled   Report[] @relation("reportsFiled")
  reportsAgainst Report[] @relation("reportsAgainst")
  reportsHandled Report[] @relation("reportsHandled")
}

// Guideline 1.2: a user must be able to block abusive users. Blocking is stored
// server-side (not in localStorage) so it is enforced on every request and
// survives reinstalls — a block hides both directions and stops DMs, follows,
// replies, and mentions.
model Block {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  blockerId String
  blockedId String
  blocker   User @relation("blocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User @relation("blocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

// Guideline 1.2: a mechanism to report offensive content. Reports land in the
// moderation queue at /studio/moderation, which is worked within 24 hours.
model Report {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  // "review" | "comment" | "thread" | "reply" | "message" | "user"
  contentType String
  contentId   String
  // "spam" | "harassment" | "hate" | "sexual" | "violence" | "self_harm"
  // | "copyright" | "impersonation" | "other"
  reason      String
  details     String?
  // Snapshot of the reported text, so moderation still works if the author
  // deletes the content before the report is reviewed.
  snapshot    String?

  // "pending" | "removed" | "dismissed" | "user_suspended"
  status       String    @default("pending")
  resolvedAt   DateTime?
  resolverNote String?

  // Nulled rather than cascaded when the reporter deletes their account: the
  // evidence and outcome have to survive so repeat offenders stay actionable,
  // but nothing identifying the reporter is kept.
  reporterId String?
  reporter   User?   @relation("reportsFiled", fields: [reporterId], references: [id], onDelete: SetNull)

  reportedUserId String?
  reportedUser   User?   @relation("reportsAgainst", fields: [reportedUserId], references: [id], onDelete: SetNull)

  resolvedById String?
  resolvedBy   User?   @relation("reportsHandled", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([contentType, contentId])
  @@index([reporterId])
}

model FollowRequest {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  requesterId String
  targetId    String
  requester   User @relation("requester", fields: [requesterId], references: [id], onDelete: Cascade)
  target      User @relation("target", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([requesterId, targetId])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// One-time code for passwordless account recovery / sign-in (sent via email or SMS).
model SignInCode {
  id        String   @id @default(cuid())
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Comment {
  id             String   @id @default(cuid())
  body           String
  albumSpotifyId String
  createdAt      DateTime @default(now())
  // Set when moderation removes this for a guideline violation; removed content
  // is hidden everywhere but retained as evidence for the report it came from.
  removedAt      DateTime?

  userId String
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes  CommentLike[]
}

model CommentLike {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId    String
  commentId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
}

model Album {
  id        String   @id @default(cuid())
  spotifyId String   @unique
  title     String
  artist    String
  artwork   String?
  year      Int?
  genres    String?
  createdAt DateTime @default(now())

  reviews Review[]
}

model Review {
  id        String   @id @default(cuid())
  rating    Float
  subject   String?
  body      String?
  favoriteSong      String?
  leastFavoriteSong String?
  showSongs         Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  removedAt DateTime? // moderation removal (guideline 1.2)

  userId  String
  albumId String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  album   Album  @relation(fields: [albumId], references: [id], onDelete: Cascade)
  likes   Like[]

  @@unique([userId, albumId])
}

model Like {
  id        String   @id @default(cuid())
  value     Int      @default(1) // 1 = like, -1 = dislike
  createdAt DateTime @default(now())

  userId   String
  reviewId String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([userId, reviewId])
}

model SavedAlbum {
  id        String   @id @default(cuid())
  spotifyId String
  title     String
  artist    String
  artwork   String?
  year      Int?
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, spotifyId])
}

model Follow {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  followerId  String
  followingId String
  follower    User   @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User   @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
}

model ArtistFollow {
  id        String   @id @default(cuid())
  artist    String
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, artist])
}

// A user-curated folder of favorite albums, shown on their profile.
model Crate {
  id        String       @id @default(cuid())
  name      String
  cover     String?      // custom cover image (data URL); falls back to a 4-album collage
  createdAt DateTime     @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  albums CrateAlbum[]
}

model CrateAlbum {
  id        String   @id @default(cuid())
  spotifyId String
  title     String
  artist    String
  artwork   String?
  year      Int?
  addedAt   DateTime @default(now())

  crateId String
  crate   Crate  @relation(fields: [crateId], references: [id], onDelete: Cascade)

  @@unique([crateId, spotifyId])
}

// A discussion thread on an album — the album forum. Album metadata is
// denormalized (like SavedAlbum/CrateAlbum) so threads work for any album.
model Thread {
  id        String   @id @default(cuid())
  title     String
  body      String
  createdAt DateTime @default(now())
  removedAt DateTime? // moderation removal (guideline 1.2)

  albumSpotifyId String
  albumTitle     String
  albumArtist    String
  albumArtwork   String?
  images         String? // JSON array of attached image data URLs (SFW-moderated)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  replies ThreadReply[]
  votes   ThreadVote[]
  shares  ThreadShare[]
  directMessages DirectMessage[]

  @@index([albumSpotifyId])
  @@index([userId])
}

// Direct (1:1) messages — the in-app DM inbox. A message is text and/or a shared
// discussion (threadId).
model DirectMessage {
  id        String   @id @default(cuid())
  body      String?
  threadId  String?
  // Shared album (denormalized so the message renders an album card).
  albumSpotifyId String?
  albumTitle     String?
  albumArtist    String?
  albumArtwork   String?
  createdAt DateTime @default(now())
  readAt    DateTime?
  removedAt DateTime? // moderation removal (guideline 1.2)

  fromId String
  from   User   @relation("dmSent", fields: [fromId], references: [id], onDelete: Cascade)
  toId   String
  to     User   @relation("dmReceived", fields: [toId], references: [id], onDelete: Cascade)
  thread Thread? @relation(fields: [threadId], references: [id], onDelete: SetNull)

  reactions MessageReaction[]

  @@index([fromId])
  @@index([toId])
}

model MessageReaction {
  id        String @id @default(cuid())
  emoji     String
  userId    String
  messageId String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   DirectMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
}

// Concerts a user has attended (or is going to) — the live-music layer of their
// music archive. Event details are denormalized from the concert source.
model ConcertAttendance {
  id         String   @id @default(cuid())
  externalId String   // source event id (e.g. SeatGeek), for de-duping
  name       String
  venue      String?
  city       String?
  date       String   // YYYY-MM-DD
  image      String?
  createdAt  DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, externalId])
  @@index([userId])
}

model ThreadVote {
  id       String @id @default(cuid())
  value    Int    @default(1) // 1 = like, -1 = dislike
  userId   String
  threadId String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread   Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([userId, threadId])
}

// A discussion shared from one user to another, in-app (shows in the recipient's inbox).
model ThreadShare {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  read       Boolean  @default(false)
  threadId   String
  fromUserId String
  toUserId   String
  thread     Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  fromUser   User   @relation("sharesSent", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser     User   @relation("sharesReceived", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([toUserId])
}

model ThreadReply {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())
  removedAt DateTime? // moderation removal (guideline 1.2)
  parentId  String?  // reply-to-reply (nested comments); null = top-level

  threadId String
  thread   Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  votes  ReplyVote[]

  @@index([threadId])
  @@index([parentId])
}

model ReplyVote {
  id      String @id @default(cuid())
  value   Int    @default(1) // 1 = like, -1 = dislike
  userId  String
  replyId String
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  reply   ThreadReply @relation(fields: [replyId], references: [id], onDelete: Cascade)

  @@unique([userId, replyId])
}

// Last known-good discography per artist.
//
// The artist page is built from a live iTunes call, so anything that makes that
// call come back empty — a throttle answering 200 with no results, a name that
// doesn't normalise the way the catalogue spells it, an outage — used to render
// as "No releases found". Three separate causes produced the identical blank
// page, and each was only noticeable once someone hit it.
//
// This is the backstop rather than a fourth fix for a fourth cause: once an
// artist's discography has been fetched successfully, it is kept, and a later
// empty answer serves the stored copy instead of nothing. Stale releases beat an
// empty page, and a genuinely unknown artist has no row so still shows empty.
model ArtistDiscographyCache {
  name      String   @id
  payload   String
  updatedAt DateTime @default(now())
}


// APNs device tokens for push delivery.
//
// Keyed by the TOKEN rather than the user: one device has exactly one token, but
// a device can change hands between accounts, and a user can have several
// devices. Keying this way means re-registering an existing device moves it to
// the current account instead of leaving a stale row that would push someone
// else's notifications to this phone.
model DeviceToken {
  token     String   @id
  userId    String
  platform  String   @default("ios")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
